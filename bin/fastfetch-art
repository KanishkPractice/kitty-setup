#!/usr/bin/env bash
# ── fastfetch-art CLI Switcher ──
# View, test, or pick fastfetch braille arts interactively.

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch"
ARTS_DIR="$CONFIG_DIR/arts"
CURRENT_ART_FILE="$CONFIG_DIR/current_art.txt"

mkdir -p "$ARTS_DIR"

usage() {
    echo -e "\033[1;36mFastfetch Braille Art Manager\033[0m"
    echo "Usage: fastfetch-art [COMMAND|ART_NAME]"
    echo ""
    echo "Commands:"
    echo "  set <name>         Set active braille art permanently (e.g. warrior, spider, cat, fox, oni)"
    echo "  list, ls           List all available braille arts"
    echo "  random, r          Run fastfetch with a random art"
    echo "  preview-all, all   Show preview of each art"
    echo "  <name>             Run fastfetch temporarily using specific art"
    echo ""
}

list_arts() {
    echo -e "\033[1;35mAvailable Braille Arts:\033[0m"
    for f in "$ARTS_DIR"/*.txt; do
        [[ -f "$f" ]] && echo "  - $(basename "$f" .txt)"
    done
}

set_art() {
    local target="$1"
    local target_art="$ARTS_DIR/$target.txt"
    if [[ -f "$target_art" ]]; then
        cp "$target_art" "$CURRENT_ART_FILE"
        echo -e "\033[1;32m✔ Fastfetch default art set to:\033[0m \033[1;36m$target\033[0m"
    else
        echo -e "\033[1;31mArt '$target' not found in $ARTS_DIR\033[0m"
        list_arts
        exit 1
    fi
}

preview_all() {
    for f in "$ARTS_DIR"/*.txt; do
        if [[ -f "$f" ]]; then
            echo -e "\n\033[1;33m=== $(basename "$f" .txt) ===\033[0m"
            fastfetch --file-raw "$f"
        fi
    done
}

case "$1" in
    ""|random|r)
        if [ -d "$ARTS_DIR" ]; then
            RANDOM_ART=$(find "$ARTS_DIR" -maxdepth 1 -type f -name "*.txt" | shuf -n 1)
            if [ -n "$RANDOM_ART" ]; then
                fastfetch --file-raw "$RANDOM_ART" "${@:2}"
                exit 0
            fi
        fi
        fastfetch "${@:2}"
        ;;
    set)
        if [[ -n "$2" ]]; then
            set_art "$2"
        else
            echo "Usage: fastfetch-art set <art_name>"
        fi
        ;;
    list|ls)
        list_arts
        ;;
    preview-all|all)
        preview_all
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        target_art="$ARTS_DIR/$1.txt"
        if [[ -f "$target_art" ]]; then
            fastfetch --file-raw "$target_art" "${@:2}"
        else
            echo -e "\033[1;31mArt '$1' not found in $ARTS_DIR\033[0m"
            list_arts
            exit 1
        fi
        ;;
esac
