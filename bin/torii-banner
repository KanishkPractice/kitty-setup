#!/usr/bin/env bash
# torii-banner - Ultra-Aesthetic Japanese Torii Shrine 24-bit TrueColor Startup Banner

# Fast exit if not a terminal
[ -t 1 ] || exit 0

# TrueColor ANSI Palette (Red Forest Torii)
RED='\033[38;2;255;51;85m'
CRIMSON='\033[38;2;230;57;70m'
DEEP_RED='\033[38;2;178;18;43m'
GOLD='\033[38;2;255;183;3m'
AMBER='\033[38;2;255;158;0m'
MINT='\033[38;2;116;198;157m'
JADE='\033[38;2;82;183;136m'
VIOLET='\033[38;2;123;97;255m'
SAKURA='\033[38;2;255;158;187m'
WHITE='\033[38;2;242;237;245m'
DIM='\033[38;2;105;92;115m'
DARK='\033[38;2;43;27;45m'
BOLD='\033[1m'
NC='\033[0m'

# System Metrics
USER_NAME=$(whoami)
HOST_NAME=$(hostname)
OS_NAME=$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"' || uname -s)
KERNEL_VER=$(uname -r | cut -d- -f1)
UPTIME=$(uptime -p 2>/dev/null | sed 's/up //' | sed 's/ hours\?,/h/' | sed 's/ minutes\?/m/' | sed 's/ days\?,/d/')
[ -z "$UPTIME" ] && UPTIME="just booted"
SHELL_NAME=$(basename "${SHELL:-zsh}")
DATE_TIME=$(date +"%a %d %b • %I:%M %p")

# RAM Usage Calculation
if [ -f /proc/meminfo ]; then
    MEM_TOTAL=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    MEM_AVAIL=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
    MEM_USED=$(( (MEM_TOTAL - MEM_AVAIL) / 1024 ))
    MEM_TOTAL_MB=$(( MEM_TOTAL / 1024 ))
    MEM_PCT=$(( (MEM_USED * 100) / MEM_TOTAL_MB ))
    MEM_BAR=""
    FILLED=$(( MEM_PCT / 10 ))
    [ $FILLED -gt 10 ] && FILLED=10
    for ((i=0; i<FILLED; i++)); do MEM_BAR+="━"; done
    EMPTY=$(( 10 - FILLED ))
    EMPTY_BAR=""
    for ((i=0; i<EMPTY; i++)); do EMPTY_BAR+="╌"; done
    RAM_DISPLAY="${MEM_USED}M/${MEM_TOTAL_MB}M ${CRIMSON}${MEM_BAR}${DIM}${EMPTY_BAR}${NC} ${DIM}(${MEM_PCT}%)${NC}"
else
    RAM_DISPLAY="Active"
fi

echo ""
echo -e "   ${RED}    ◢██████████████████████████████████████◣${NC}"
echo -e "   ${RED}  ◢████◤   ██   ██          ██   ██   ◥████◣${NC}    ${BOLD}${WHITE}${USER_NAME}${NC}${RED}⛩${NC}${VIOLET}${HOST_NAME}${NC}"
echo -e "   ${CRIMSON} ═══════════██═══██══════════██═══██═══════════${NC}    ${DIM}────────────────────────────${NC}"
echo -e "   ${CRIMSON}      🏮    ██   ██   ${GOLD}鳥  居${CRIMSON}   ██   ██    🏮${NC}       ${RED}OS:${NC}      ${WHITE}${OS_NAME}${NC}"
echo -e "   ${DEEP_RED}    ────── ◢██   ██◣ ────── ◢██   ██◣ ──────${NC}      ${GOLD}Kernel:${NC}  ${WHITE}${KERNEL_VER}${NC}"
echo -e "   ${CRIMSON}            ██   ██          ██   ██${NC}            ${MINT}Uptime:${NC}  ${WHITE}${UPTIME}${NC}"
echo -e "   ${CRIMSON}            ██   ██          ██   ██${NC}            ${VIOLET}Shell:${NC}   ${WHITE}${SHELL_NAME}${NC}"
echo -e "   ${CRIMSON}            ██   ██          ██   ██${NC}            ${SAKURA}Memory:${NC}  ${WHITE}${RAM_DISPLAY}${NC}"
echo -e "   ${CRIMSON}           ◢██   ██◣        ◢██   ██◣${NC}           ${AMBER}Time:${NC}    ${WHITE}${DATE_TIME}${NC}"
echo -e "   ${DIM} ───────── ▀▀▀───▀▀▀ ────── ▀▀▀───▀▀▀ ─────────${NC}    ${RED}Theme:${NC}   ${WHITE}Red Forest Torii ⛩${NC}"
echo -e "    ${DIM}●${NC} ${DEEP_RED}●${NC} ${CRIMSON}●${NC} ${RED}●${NC} ${GOLD}●${NC} ${MINT}●${NC} ${VIOLET}●${NC} ${SAKURA}●${NC} ${WHITE}●${NC}   ${DIM}│ ${BOLD}scmd${NC} ${DIM}cheatsheet • ${BOLD}rice${NC} ${DIM}lounge • ${BOLD}cool${NC} ${DIM}tools${NC}"
echo ""
