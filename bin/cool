#!/usr/bin/env bash
# cool - Aesthetic & Visual Terminal Tools Hub
# Interactive fuzzy runner and visual launcher for rice, screensavers, and terminal art

# Color definitions
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
BOLD='\033[1m'
NC='\033[0m'

show_banner() {
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║${CYAN}             🌌 AESTHETIC & CYBERPUNK TERMINAL TOOLS                     ${MAGENTA}║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

list_tools() {
    show_banner
    printf "  ${BOLD}%-15s${NC} │ ${CYAN}%-32s${NC} │ ${YELLOW}%s${NC}\n" "COMMAND" "CATEGORY / DESCRIPTION" "QUICK LAUNCH USAGE"
    echo -e "  ────────────────┼──────────────────────────────────┼──────────────────────────────────────"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "cava" "Audio Visualizer (Cyberpunk Glow)" "cava"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "tty-clock" "Minimalist Floating Digital Clock" "tty-clock -C 6 -c -s -b"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "pipes-rs" "Animated 3D Pipes Screensaver" "pipes-rs (or pipes)"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "fastfetch" "Modern Hardware Specs & ASCII Logo" "fastfetch"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "asciiquarium" "ASCII Ocean Aquarium Screensaver" "asciiquarium"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "btop" "Cyberpunk System & GPU Monitor" "btop"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "cmatrix" "Matrix Digital Rain Screensaver" "cmatrix (or matrix)"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "cbonsai" "Living Procedural Bonsai Tree" "cbonsai -l (or bonsai)"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "sl" "Steam Locomotive Animation" "sl"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "oneko" "Pixel Cat Desktop Cursor Chaser" "oneko &"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "figlet" "ASCII Text Art Generator" "figlet 'KITTY' | lolcat"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "toilet" "High-Def Colored ASCII Font" "toilet -f slant --filter metal 'NEOVIM'"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "cowsay" "Quote of the Day in ASCII Bubble" "fortune | cowsay | lolcat"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "chafa" "Terminal Image & GIF Player" "chafa <image/gif>"
    printf "  ${GREEN}%-15s${NC} │ %-32s │ ${BLUE}%s${NC}\n" "lazygit" "Full Floating Git UI" "lazygit"
    echo ""
    echo -e "  ${YELLOW}Tip:${NC} Run ${BOLD}cool -i${NC} (or ${BOLD}cool --menu${NC}) for interactive selection with live preview!"
    echo ""
}

interactive_menu() {
    if ! command -v fzf >/dev/null 2>&1; then
        list_tools
        return
    fi

    local selected
    selected=$(
        {
            printf "%-14s │ %-34s │ %s\n" "cava" "Audio Visualizer (Cyberpunk Glow)" "cava"
            printf "%-14s │ %-34s │ %s\n" "tty-clock" "Minimalist Floating Digital Clock" "tty-clock -C 6 -c -s -b"
            printf "%-14s │ %-34s │ %s\n" "pipes-rs" "Animated 3D Pipes Screensaver" "pipes-rs"
            printf "%-14s │ %-34s │ %s\n" "fastfetch" "Modern Hardware Specs & ASCII Art" "fastfetch"
            printf "%-14s │ %-34s │ %s\n" "asciiquarium" "ASCII Ocean Aquarium Screensaver" "asciiquarium"
            printf "%-14s │ %-34s │ %s\n" "btop" "Cyberpunk System & GPU Monitor" "btop"
            printf "%-14s │ %-34s │ %s\n" "cmatrix" "Matrix Digital Rain Screensaver" "cmatrix"
            printf "%-14s │ %-34s │ %s\n" "cbonsai" "Living Procedural Bonsai Tree" "cbonsai -l"
            printf "%-14s │ %-34s │ %s\n" "sl" "Steam Locomotive Animation" "sl"
            printf "%-14s │ %-34s │ %s\n" "oneko" "Pixel Cat Desktop Cursor Chaser" "oneko &"
            printf "%-14s │ %-34s │ %s\n" "figlet" "ASCII Text Banner Generator" "figlet 'KITTY' | lolcat"
            printf "%-14s │ %-34s │ %s\n" "toilet" "High-Def Metal/Rainbow ASCII Font" "toilet -f slant --filter metal 'NEOVIM'"
            printf "%-14s │ %-34s │ %s\n" "cowsay" "Quote of the Day in ASCII Speech Bubble" "fortune | cowsay | lolcat"
            printf "%-14s │ %-34s │ %s\n" "chafa" "Terminal Image & GIF Player" "chafa --help"
            printf "%-14s │ %-34s │ %s\n" "lazygit" "Full Floating Git UI" "lazygit"
        } | fzf \
            --delimiter=' │ ' \
            --with-nth=1,2 \
            --header="✨ [AESTHETIC TOOLS LAUNCHER] (Enter to Launch, Esc to Exit)" \
            --prompt="🌌 Select Tool > " \
            --preview='echo -e "\033[1;36mTool:\033[0m        {1}\n\033[1;35mDescription:\033[0m {2}\n\033[1;32mCommand:\033[0m     {3}\n\n\033[1;33mInstalled Path:\033[0m $(which {1} 2>/dev/null || echo "Not found")"' \
            --preview-window=right:45%:wrap
    )

    if [[ -n "$selected" ]]; then
        local run_cmd
        run_cmd=$(echo "$selected" | awk -F ' │ ' '{print $3}')
        echo -e "${CYAN}Launching:${NC} ${BOLD}$run_cmd${NC}"
        eval "$run_cmd"
    fi
}

case "$1" in
    -i|--menu|menu)
        interactive_menu
        ;;
    -h|--help|help)
        show_banner
        echo "Usage: cool [options]"
        echo ""
        echo "Options:"
        echo "  (no args)    Display formatted visual tools table"
        echo "  -i, --menu   Open interactive fuzzy selector with live preview"
        echo "  -h, --help   Show this help message"
        echo ""
        ;;
    *)
        list_tools
        ;;
esac
