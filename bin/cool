#!/usr/bin/env bash
# cool - Aesthetic & Visual Terminal Tools Hub
# Interactive fuzzy runner and visual launcher for rice, screensavers, and terminal art

CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
RED='\033[1;31m'
BOLD='\033[1m'
NC='\033[0m'

show_banner() {
    echo -e "  \033[1;38;2;255;51;85m╭──────────────────────────────────────────────────────────────────────────╮\033[0m"
    echo -e "  \033[1;38;2;255;51;85m│\033[0m            \033[1;38;2;0;245;212m🕷️  AESTHETIC & CREATIVE TERMINAL SUITE (CYBERPUNK) ✦\033[0m          \033[1;38;2;255;51;85m│\033[0m"
    echo -e "  \033[1;38;2;255;51;85m╰──────────────────────────────────────────────────────────────────────────╯\033[0m"
    echo ""
}

list_tools() {
    show_banner
    printf "  \033[1;38;2;0;245;212m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[1;38;2;248;249;250m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[1;38;2;166;227;161m%s\033[0m\n" "COMMAND" "CATEGORY / DESCRIPTION" "QUICK LAUNCH USAGE"
    echo -e "  \033[38;2;108;112;134m─────────────────┼──────────────────────────────────────────┼──────────────────────────────────────\033[0m"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "rice" "Aesthetic Lounge (Cava+Btop+Clock)" "rice"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "scmd" "Fuzzy Command & Shortcut Cheatsheet" "scmd"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "matrix-red" "Crimson Matrix Digital Rain" "matrix-red"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "cava" "Audio Visualizer (Gradient Shaders)" "cava"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "tty-clock" "Minimalist Floating Digital Clock" "tty-clock -C 1 -c -s -b"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "fastfetch" "Modern Hardware Specs & ASCII Art" "fastfetch"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "btop" "Cyberpunk System & GPU Monitor" "btop"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "pipes-rs" "Animated 3D Pipes Screensaver" "pipes-rs"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "cbonsai" "Living Procedural Bonsai Tree" "cbonsai -l"
    printf "  \033[1;38;2;255;77;109m%-16s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;229;231;235m%-40s\033[0m \033[38;2;108;112;134m│\033[0m \033[38;2;166;227;161m%s\033[0m\n" "lazygit" "Full Floating Git UI" "lazygit"
    echo ""
    echo -e "  \033[1;38;2;255;117;143mTip:\033[0m Run \033[1;38;2;0;245;212mcool -i\033[0m (or \033[1;38;2;0;245;212mcool --menu\033[0m) for interactive fuzzy selector with live preview!"
    echo ""
}

interactive_menu() {
    if ! command -v fzf >/dev/null 2>&1; then
        list_tools
        return
    fi

    local selected
    selected=$(
        {
            printf "%-14s │ %-38s │ %s\n" "rice" "Aesthetic Lounge (Cava+Btop+Clock)" "kitty --session ~/.config/kitty/sessions/rice.session &"
            printf "%-14s │ %-38s │ %s\n" "scmd" "Fuzzy Command & Shortcut Cheatsheet" "scmd"
            printf "%-14s │ %-38s │ %s\n" "matrix-red" "Crimson Matrix Digital Rain" "matrix-red"
            printf "%-14s │ %-38s │ %s\n" "cava" "Audio Visualizer (Gradient)" "cava"
            printf "%-14s │ %-38s │ %s\n" "tty-clock" "Minimalist Floating Digital Clock" "tty-clock -C 1 -c -s -b"
            printf "%-14s │ %-38s │ %s\n" "pipes-rs" "Animated 3D Pipes Screensaver" "pipes-rs"
            printf "%-14s │ %-38s │ %s\n" "fastfetch" "Modern Hardware Specs & Telemetry" "fastfetch"
            printf "%-14s │ %-38s │ %s\n" "asciiquarium" "ASCII Ocean Aquarium Screensaver" "asciiquarium"
            printf "%-14s │ %-38s │ %s\n" "btop" "Cyberpunk System & GPU Monitor" "btop"
            printf "%-14s │ %-38s │ %s\n" "cbonsai" "Living Procedural Bonsai Tree" "cbonsai -l"
            printf "%-14s │ %-38s │ %s\n" "lazygit" "Full Floating Git UI" "lazygit"
        } | fzf \
            --delimiter=' │ ' \
            --with-nth=1,2 \
            --header="✦ [AESTHETIC TOOLS LAUNCHER] (Enter to Launch, Esc to Exit)" \
            --prompt="❯ Select Tool > " \
            --preview='echo -e "\033[1;36mTool:\033[0m        {1}\n\033[1;35mDescription:\033[0m {2}\n\033[1;32mCommand:\033[0m     {3}\n\n\033[1;33mInstalled Path:\033[0m $(which {1} 2>/dev/null || echo "Not found")"' \
            --preview-window=right:45%:wrap
    )

    if [[ -n "$selected" ]]; then
        local run_cmd
        run_cmd=$(echo "$selected" | awk -F ' │ ' '{print $3}')
        echo -e "${CYAN}Launching:${NC} ${BOLD}$run_cmd${NC}"
        eval "$run_cmd"
    fi
}

case "$1" in
    -i|--menu|menu)
        interactive_menu
        ;;
    -h|--help|help)
        show_banner
        echo "Usage: cool [options]"
        echo ""
        echo "Options:"
        echo "  (no args)    Display formatted visual tools table"
        echo "  -i, --menu   Open interactive fuzzy selector with live preview"
        echo "  -h, --help   Show this help message"
        echo ""
        ;;
    *)
        list_tools
        ;;
esac
