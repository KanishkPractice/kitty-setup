#!/usr/bin/env bash
# theme-switch - Interactive Aesthetic Theme Switcher for Kitty
# Hot-swaps terminal palettes with instant live reload & fuzzy preview

THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/themes"
CURRENT_THEME_FILE="$THEMES_DIR/current-theme.conf"

# Ensure themes dir exists
mkdir -p "$THEMES_DIR"

CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
BOLD='\033[1m'
NC='\033[0m'

apply_theme() {
    local theme_name="$1"
    local theme_path="$THEMES_DIR/${theme_name}.conf"

    if [ ! -f "$theme_path" ]; then
        # Check if user omitted .conf or passed a partial name
        local match
        match=$(find "$THEMES_DIR" -maxdepth 1 -name "*${theme_name}*.conf" | head -n 1)
        if [ -n "$match" ] && [ -f "$match" ]; then
            theme_path="$match"
            theme_name=$(basename "$match" .conf)
        else
            echo -e "${YELLOW}Theme '${theme_name}' not found in ${THEMES_DIR}${NC}"
            list_themes
            return 1
        fi
    fi

    # Update current-theme.conf
    cp "$theme_path" "$CURRENT_THEME_FILE"

    # Reload kitty theme live if inside kitty
    if [ -n "$KITTY_PID" ] || [ "$TERM" = "xterm-kitty" ]; then
        # Try live socket reload
        if [ -S "/tmp/kitty-$KITTY_PID" ]; then
            kitty @ --to "unix:/tmp/kitty-$KITTY_PID" set-colors --all "$theme_path" 2>/dev/null || true
        fi
        # Also trigger config reload
        kill -SIGUSR1 "$KITTY_PID" 2>/dev/null || true
    fi

    echo -e "${GREEN}✔ Successfully applied theme:${NC} ${BOLD}${CYAN}${theme_name}${NC}"
}

list_themes() {
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║${CYAN}                🎨 CURATED AESTHETIC KITTY THEMES                         ${MAGENTA}║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    for f in "$THEMES_DIR"/*.conf; do
        [ -e "$f" ] || continue
        local bname
        bname=$(basename "$f" .conf)
        [ "$bname" = "current-theme" ] && continue
        printf "  ${BOLD}%-20s${NC} → %s\n" "$bname" "$f"
    done
    echo ""
    echo -e "  ${YELLOW}Usage:${NC} theme <name>  (e.g., ${CYAN}theme tokyo-night${NC} or ${CYAN}theme rose-pine${NC})"
    echo -e "         ${YELLOW}theme -i${NC}          (Interactive fuzzy picker with live preview)"
    echo ""
}

interactive_picker() {
    if ! command -v fzf >/dev/null 2>&1; then
        list_themes
        return
    fi

    local selected
    selected=$(
        for f in "$THEMES_DIR"/*.conf; do
            [ -e "$f" ] || continue
            local bname
            bname=$(basename "$f" .conf)
            [ "$bname" = "current-theme" ] && continue
            echo "$bname"
        done | fzf \
            --height=45% \
            --layout=reverse \
            --border=rounded \
            --header="🎨 [KITTY THEME SWITCHER] (Enter to Apply, Esc to Cancel)" \
            --prompt="✨ Select Theme > " \
            --preview="cat $THEMES_DIR/{}.conf | head -n 35" \
            --preview-window=right:55%:wrap
    )

    if [ -n "$selected" ]; then
        apply_theme "$selected"
    fi
}

case "$1" in
    "")
        interactive_picker
        ;;
    -i|--interactive|menu)
        interactive_picker
        ;;
    -l|--list|list)
        list_themes
        ;;
    -h|--help|help)
        echo "Usage: theme [theme-name | -i | -l | -h]"
        ;;
    *)
        apply_theme "$1"
        ;;
esac
