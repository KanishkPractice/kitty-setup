#!/usr/bin/env bash
# set-login-wallpaper - Apply Red Forest Torii Wallpaper to SDDM Login Screen & KDE Lock Screen

VIDEO_SRC="/home/kanishk/Downloads/mylivewallpapers-com-Red-Forest-Torii-4K.mp4"
STATIC_SRC="$HOME/Pictures/Wallpapers/red-forest-torii-4k.png"
SDDM_THEME_DIR="/usr/share/sddm/themes/sword"

GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

# 1. Update KDE Plasma Lockscreen
if [ -f "$STATIC_SRC" ]; then
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "file://$STATIC_SRC" 2>/dev/null || true
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key PreviewImage "file://$STATIC_SRC" 2>/dev/null || true
    kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin "org.kde.image" 2>/dev/null || true
    echo -e "${GREEN}✔ KDE Lock Screen wallpaper updated successfully!${NC}"
fi

# 2. Update SDDM Login Screen
if [ -d "$SDDM_THEME_DIR" ]; then
    if [ $(id -u) -ne 0 ]; then
        echo -e "${YELLOW}Updating SDDM login screen requires sudo privileges.${NC}"
        echo -e "${CYAN}Running:${NC} sudo cp -f \"$VIDEO_SRC\" \"$SDDM_THEME_DIR/bg.mp4\""
        sudo cp -f "$VIDEO_SRC" "$SDDM_THEME_DIR/bg.mp4" && \
        sudo chmod 644 "$SDDM_THEME_DIR/bg.mp4" && \
        echo -e "${GREEN}✔ SDDM Login Screen video wallpaper updated successfully!${NC}"
    else
        cp -f "$VIDEO_SRC" "$SDDM_THEME_DIR/bg.mp4"
        chmod 644 "$SDDM_THEME_DIR/bg.mp4"
        echo -e "${GREEN}✔ SDDM Login Screen video wallpaper updated successfully!${NC}"
    fi
fi
