#!/usr/bin/env bash
# live-wallpaper - Video & Still Wallpaper Manager for KDE & Wayland
WALLPAPER_VIDEO="/home/kanishk/Downloads/mylivewallpapers-com-Red-Forest-Torii-4K.mp4"
WALLPAPER_STATIC="$HOME/Pictures/Wallpapers/red-forest-torii-4k.png"

CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

case "$1" in
    static|image|still|"")
        if [ ! -f "$WALLPAPER_STATIC" ]; then
            mkdir -p "$HOME/Pictures/Wallpapers"
            ffmpeg -y -ss 00:00:03 -i "$WALLPAPER_VIDEO" -vframes 1 -q:v 2 "$WALLPAPER_STATIC" 2>/dev/null
        fi
        plasma-apply-wallpaperimage "$WALLPAPER_STATIC"
        echo -e "${GREEN}✔ 4K Red Forest Torii still wallpaper applied!${NC}"
        ;;
    video|live|play)
        if command -v mpvpaper >/dev/null 2>&1; then
            pkill mpvpaper 2>/dev/null || true
            mpvpaper -vs -o "load-scripts=no no-audio loop-file=inf" ALL "$WALLPAPER_VIDEO" &
            echo -e "${GREEN}✔ Live 4K video wallpaper playing with mpvpaper!${NC}"
        else
            echo -e "${YELLOW}mpvpaper is not installed.${NC} Applied 4K static wallpaper instead."
            plasma-apply-wallpaperimage "$WALLPAPER_STATIC"
            echo -e "${CYAN}Tip:${NC} Install mpvpaper with: ${BOLD}sudo dnf install mpvpaper${NC} (or build from source) to enable live video wallpaper loop."
        fi
        ;;
    stop|kill)
        pkill mpvpaper 2>/dev/null || true
        plasma-apply-wallpaperimage "$WALLPAPER_STATIC"
        echo -e "${GREEN}✔ Live wallpaper stopped and restored to 4K static background.${NC}"
        ;;
    *)
        echo "Usage: live-wallpaper [static | video | stop]"
        ;;
esac
