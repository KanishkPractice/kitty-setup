# Catppuccin Mocha theme for btop

# Main background — empty = use terminal bg (transparency-friendly)
theme[main_bg]=

# Main text color
theme[main_fg]=#cdd6f4

# Title color for boxes
theme[title]=#cdd6f4

# Highlight color for keyboard shortcuts
theme[hi_fg]=#cba6f7

# Background color of selected item in processes box
theme[selected_bg]=#45475a

# Foreground color of selected item in processes box
theme[selected_fg]=#cdd6f4

# Color of inactive/disabled text
theme[inactive_fg]=#6c7086

# Color of text on top of graphs
theme[graph_text]=#f9e2af

# Background color of percentage meters
theme[meter_bg]=#313244

# Misc colors for processes box
theme[proc_misc]=#f5c2e7

# Box outline colors
theme[cpu_box]=#cba6f7
theme[mem_box]=#89b4fa
theme[net_box]=#94e2d5
theme[proc_box]=#f5c2e7

# Box divider line
theme[div_line]=#45475a

# Temperature gradient: cool → warm → hot
theme[temp_start]=#89b4fa
theme[temp_mid]=#f9e2af
theme[temp_end]=#f38ba8

# CPU graph gradient
theme[cpu_start]=#cba6f7
theme[cpu_mid]=#89b4fa
theme[cpu_end]=#a6e3a1

# Mem/Disk free meter
theme[free_start]=#94e2d5
theme[free_mid]=#a6e3a1
theme[free_end]=#a6e3a1

# Mem/Disk cached meter
theme[cached_start]=#89b4fa
theme[cached_mid]=#94e2d5
theme[cached_end]=#a6e3a1

# Mem/Disk available meter
theme[available_start]=#cba6f7
theme[available_mid]=#f5c2e7
theme[available_end]=#f5c2e7

# Mem/Disk used meter
theme[used_start]=#f9e2af
theme[used_mid]=#fab387
theme[used_end]=#f38ba8

# Download graph
theme[download_start]=#89b4fa
theme[download_mid]=#94e2d5
theme[download_end]=#a6e3a1

# Upload graph
theme[upload_start]=#cba6f7
theme[upload_mid]=#f5c2e7
theme[upload_end]=#f5c2e7

# Process box gradient
theme[process_start]=#89b4fa
theme[process_mid]=#a6e3a1
theme[process_end]=#94e2d5
