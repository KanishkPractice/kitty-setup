// Catppuccin Mocha themed Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "type": "builtin",
    "color": {
      "1": "38;2;203;166;247",
      "2": "38;2;137;180;250"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;108;112;134"
    }
  },
  "modules": [
    {
      "key": "╭───────────────╮",
      "type": "custom"
    },
    {
      "key": "│ {#38;2;137;180;250}  user     {#keys}  │",
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "key": "│ {#38;2;250;179;135} 󰥔 time     {#keys}  │",
      "type": "datetime",
      "format": "{weekday}, {month-name} {day-pretty} · {hour-12-pretty}:{minute-pretty} {am-pm}"
    },
    {
      "key": "├───────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#38;2;166;227;161} 󰣇 distro   {#keys}  │",
      "type": "os"
    },
    {
      "key": "│ {#38;2;245;194;231} 󰌽 kernel   {#keys}  │",
      "type": "kernel"
    },
    {
      "key": "├───────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#38;2;137;180;250} 󰻠 cpu      {#keys}  │",
      "type": "cpu",
      "format": "{name}"
    },
    {
      "key": "│ {#38;2;166;227;161} 󰢮 gpu      {#keys}  │",
      "type": "gpu",
      "format": "{name}",
      "detectionMethod": "pci"
    },
    {
      "key": "│ {#38;2;245;194;231} 󰍛 memory   {#keys}  │",
      "type": "memory",
      "percent": {
        "type": 3
      }
    },
    {
      "key": "│ {#38;2;249;226;175} 󰋊 disk     {#keys}  │",
      "type": "disk",
      "folders": "/",
      "percent": {
        "type": 3
      }
    },
    {
      "key": "│ {#38;2;148;226;213} 󰍹 display  {#keys}  │",
      "type": "display",
      "compactType": "original"
    },
    {
      "key": "├───────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#38;2;166;227;161} 󰏗 apps     {#keys}  │",
      "type": "packages"
    },
    {
      "key": "│ {#38;2;148;226;213} 󰸗 OS age   {#keys}  │",
      "type": "command",
      "text": "birth=$(stat -c %W /); now=$(date +%s); echo $(( (now - birth) / 86400 )) days"
    },
    {
      "key": "├───────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#38;2;108;112;134} 󰏘 colors   {#keys}  │",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "╰───────────────╯",
      "type": "custom"
    }
  ]
}
