// Catppuccin Mocha themed Fastfetch - Rounded border style
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "fedora_small",
    "type": "builtin",
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;147;153;178",
    },
  },
  "modules": [
    {
      "key": "╭─────────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#38;2;243;139;168}  user     {#keys} │",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#38;2;137;180;250}  uptime   {#keys} │",
      "type": "uptime",
    },
    {
      "key": "│ {#38;2;249;226;175}  display  {#keys} │",
      "type": "display",
      "compactType": "original",
    },
    {
      "key": "│ {#38;2;166;227;161}  distro   {#keys} │",
      "type": "os",
    },
    {
      "key": "│ {#38;2;245;194;231}  kernel   {#keys} │",
      "type": "kernel",
    },
    {
      "key": "│ {#38;2;203;166;247}  DE       {#keys} │",
      "type": "de",
    },
    {
      "key": "│ {#38;2;243;139;168}  term     {#keys} │",
      "type": "terminal",
    },
    {
      "key": "│ {#38;2;249;226;175}  apps     {#keys} │",
      "type": "packages",
    },
    {
      "key": "│ {#38;2;137;180;250}  disk     {#keys} │",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│ {#38;2;166;227;161}  memory   {#keys} │",
      "type": "memory",
    },
    {
      "key": "│ {#38;2;148;226;213}  OS Age   {#keys} │",
      "type": "command",
      "text": "birth=$(stat -c %W /); now=$(date +%s); echo $(( (now - birth) / 86400 )) days",
    },
    {
      "key": "├─────────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#38;2;88;91;112}◀  colors  {#keys} │",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰─────────────╯",
      "type": "custom",
    },
  ],
}
