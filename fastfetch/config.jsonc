// Catppuccin Mocha Clean Horizontal Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "   "
  },
  "modules": [
    {
      "type": "command",
      "key": "  󰣇 SYS ",
      "keyColor": "38;2;203;166;247",
      "text": "distro=$(. /etc/os-release 2>/dev/null && echo \"$PRETTY_NAME\" || uname -s); arch=$(uname -m); kernel=$(uname -r); upt=$(uptime -p 2>/dev/null | sed 's/^up //' || uptime | awk '{print $3}' | tr -d ','); echo \"$distro $arch · Linux $kernel · $upt\""
    },
    {
      "type": "custom",
      "format": "  {#38;2;108;112;134}─────────────────────────────────────────────────────────────"
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU ",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU ",
      "keyColor": "38;2;166;227;161",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "  󰍛 RAM ",
      "keyColor": "38;2;245;194;231",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "disk",
      "key": "  󰋊 DISK",
      "keyColor": "38;2;249;226;175",
      "folders": "/",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "display",
      "key": "  󰍹 RES ",
      "keyColor": "38;2;148;226;213",
      "compactType": "original"
    },
    {
      "type": "wm",
      "key": "  󰖲 WM  ",
      "keyColor": "38;2;180;190;254"
    },
    {
      "type": "packages",
      "key": "  󰏗 PKGS",
      "keyColor": "38;2;250;179;135"
    },
    {
      "type": "colors",
      "key": "  󰏘 PAL ",
      "symbol": "circle"
    }
  ]
}
