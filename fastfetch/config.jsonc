{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "fedora",
    "type": "builtin",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;160;219;211",
      "title": "38;2;181;214;139"
    },
    "key": {
      "width": 11
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;38;2;160;219;211m󰮯  {user-name}\u001b[0m\u001b[38;2;228;216;190m@\u001b[0m\u001b[1;38;2;181;214;139m{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;101;115;126m──────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "󰣛 OS"
    },
    {
      "type": "host",
      "key": "󰋜 Host"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "compactType": "original"
    },
    {
      "type": "de",
      "key": "󰧨 DE"
    },
    {
      "type": "wm",
      "key": "󱂬 WM"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "󰁹 Battery"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;71;85;105m──────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
