{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/kanishk/.config/fastfetch/logos/miles_morales.png",
    "type": "kitty",
    "width": 28,
    "height": 14,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰄯 ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    },
    "key": {
      "width": 16
    },
    "percent": {
      "type": 3
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "width": 12
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored} 󱄅 {host-name-colored}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;65;72;104m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;122;162;247m  SYSTEM STATS\u001b[0m"
    },
    {
      "type": "os",
      "key": "  󰅂 OS",
      "keyColor": "38;2;125;207;255"
    },
    {
      "type": "kernel",
      "key": "  󰅂 Kernel",
      "keyColor": "38;2;125;207;255"
    },
    {
      "type": "wm",
      "key": "  󱂬 WM",
      "keyColor": "38;2;125;207;255"
    },
    {
      "type": "terminal",
      "key": "  󰞷 Terminal",
      "keyColor": "38;2;125;207;255"
    },
    {
      "type": "shell",
      "key": "  󱆃 Shell",
      "keyColor": "38;2;125;207;255"
    },
    {
      "type": "uptime",
      "key": "  󱑂 Uptime",
      "keyColor": "38;2;125;207;255"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "38;2;125;207;255"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;187;154;247m󰢮  HARDWARE STATS\u001b[0m"
    },
    {
      "type": "host",
      "key": "  󰌢 Host",
      "keyColor": "38;2;187;154;247"
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU",
      "keyColor": "38;2;187;154;247",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU",
      "keyColor": "38;2;187;154;247",
      "temp": true
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory",
      "keyColor": "38;2;187;154;247"
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk",
      "keyColor": "38;2;187;154;247"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
