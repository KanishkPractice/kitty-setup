{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": " 󰅂 ",
    "color": {
      "keys": "magenta",
      "title": "red"
    },
    "key": {
      "width": 14
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored} 󰄯 {host-name-colored}"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────────────────"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "38;2;86;207;225"
    },
    {
      "type": "os",
      "key": "󰣛 OS",
      "keyColor": "38;2;86;207;225"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "38;2;123;97;255"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime",
      "keyColor": "38;2;255;183;3"
    },
    {
      "type": "shell",
      "key": "󱆃 Shell",
      "keyColor": "38;2;116;198;157"
    },
    {
      "type": "wm",
      "key": "󱂬 Desktop",
      "keyColor": "38;2;86;207;225"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "38;2;255;117;143"
    },
    {
      "type": "terminal",
      "key": "󰞷 Terminal",
      "keyColor": "38;2;255;51;85"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "38;2;123;97;255",
      "temp": false
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "38;2;86;207;225",
      "temp": false
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "38;2;116;198;157"
    },
    {
      "type": "disk",
      "key": "󰋊 Storage",
      "keyColor": "38;2;255;183;3"
    },
    {
      "type": "battery",
      "key": "󱊣 Battery",
      "keyColor": "38;2;116;198;157"
    },
    {
      "type": "localip",
      "key": "󰩟 Local IP",
      "keyColor": "38;2;123;97;255",
      "showIpv6": false
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
