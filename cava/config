## CAVA — Clean Monochrome White Theme
## Ultra-smooth 90fps, balanced frequency response & crisp white bars

[general]
# High-definition 90 FPS rendering for smooth liquid motion
framerate = 90
autosens = 1
overshoot = 20
sensitivity = 65
bars = 0
bar_width = 3
bar_spacing = 1
bar_height = 32
lower_cutoff_freq = 40
higher_cutoff_freq = 14000
sleep_timer = 0

[input]
method = pulse
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
mono_option = average
reverse = 0
show_idle_bar_heads = 1

[color]
# Clean White / Monochrome Theme
foreground = '#ffffff'
# Alternatively with gradient = 0 (solid white bars)
gradient = 0

[smoothing]
# Monstercat dynamic audio smoothing
monstercat = 1
integral = 75
gravity = 110
noise_reduction = 60

[eq]
# Dynamic Equalizer curve (boosts mid and high frequencies so all bars dance together)
1 = 0.85   # Sub-bass
2 = 1.05   # Mid-bass
3 = 1.30   # Mid-range
4 = 1.65   # Upper mids
5 = 1.95   # High treble
