## CAVA — "Cyberpunk Neon Matrix" Palette
## Electric Blue -> Cyan -> Mint -> Neon Green -> Cyber Yellow -> Coral -> Hot Pink

[general]
framerate = 60
autosens = 1
sensitivity = 70
bars = 0
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 12000
sleep_timer = 0

[input]
method = pulse
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
mono_option = average
reverse = 0
show_idle_bar_heads = 1

[color]
# 8-Stop Cyberpunk Neon Matrix Gradient (High contrast, vibrant glow)
gradient = 1
gradient_count = 8

gradient_color_1 = '#0066ff'  # Electric Blue (Base ground)
gradient_color_2 = '#00d2ff'  # Laser Cyan
gradient_color_3 = '#00f5d4'  # Bright Mint
gradient_color_4 = '#00ff87'  # Neon Matrix Green
gradient_color_5 = '#a6ff00'  # Lime Highlighter
gradient_color_6 = '#ffee00'  # Cyber Electric Yellow
gradient_color_7 = '#ff6b35'  # Neon Coral Flame
gradient_color_8 = '#ff007f'  # Hyper Hot Pink (Peak)

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 68

[eq]
1 = 1.0
2 = 1.0
3 = 1.0
4 = 1.0
5 = 1.0
