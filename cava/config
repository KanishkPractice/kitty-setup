## CAVA — Everforest Gradient Theme
## Smooth 60fps, balanced frequency response & gradient bars

[general]
# 60 FPS — visually identical to 90fps in terminal, saves CPU
framerate = 60
autosens = 1
overshoot = 20
sensitivity = 35
bars = 0
bar_width = 3
bar_spacing = 1
bar_height = 32
lower_cutoff_freq = 40
higher_cutoff_freq = 14000
sleep_timer = 0

[input]
method = pulse
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
mono_option = average
reverse = 0
show_idle_bar_heads = 1

[color]
# Everforest gradient: green → aqua → mint → lavender
gradient = 1
gradient_count = 4
gradient_color_1 = '#c5e89b'
gradient_color_2 = '#a0dbd3'
gradient_color_3 = '#aee8ba'
gradient_color_4 = '#f3b9d6'

[smoothing]
# Monstercat dynamic audio smoothing
monstercat = 1
integral = 75
gravity = 110
noise_reduction = 60

[eq]
# Lower intensity balanced equalizer curve
1 = 0.60   # Sub-bass
2 = 0.75   # Mid-bass
3 = 0.85   # Mid-range
4 = 0.95   # Upper mids
5 = 1.05   # High treble
