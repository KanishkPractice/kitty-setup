# ~/.config/kitty/kitty.conf
# Catppuccin Mocha Theme (Official Kitty Palette)

# ── 1. FONTS & TYPOGRAPHY ──────────────────────────────────
font_family      FantasqueSansM Nerd Font Mono
bold_font        FantasqueSansM Nerd Font Mono Bold
italic_font      FantasqueSansM Nerd Font Mono Italic
bold_italic_font FantasqueSansM Nerd Font Mono Bold Italic
font_size        18.0
disable_ligatures never
box_drawing_scale 0.001, 1, 1.5, 2

# ── 2. CURSOR & ANIMATIONS ────────────────────────────────
cursor                 #f5e0dc
cursor_text_color      #1e1e2e
cursor_shape           beam
cursor_shape_unfocused hollow
cursor_blink_interval  0.5 ease-in-out
cursor_stop_blinking_after 10

# Mauve cursor trail animation
cursor_trail                 8
cursor_trail_color           #cba6f7
cursor_trail_decay           0.05 0.15
cursor_trail_start_threshold 6

# ── 3. WINDOW & LAYOUT ────────────────────────────────────
window_padding_width        10
window_margin_width         0
single_window_margin_width  -1
window_border_width         2pt
draw_minimal_borders        no
hide_window_decorations     no
enabled_layouts              splits,tall,stack
remember_window_size        yes
confirm_os_window_close     0

# ── 4. TRANSPARENCY & EFFECTS ─────────────────────────────
background_opacity          0.75
dynamic_background_opacity  yes
inactive_text_alpha          0.92

# ── 5. TAB BAR ────────────────────────────────────────────
tab_bar_edge          top
tab_bar_style         powerline
tab_powerline_style   slanted
tab_bar_min_tabs      1
tab_title_template    "{index}: {title}"

# ── 6. CLIPBOARD & MOUSE ──────────────────────────────────
copy_on_select        yes
strip_trailing_spaces smart
mouse_hide_wait       3.0
pointer_shape_when_grabbed hand
mouse_map right press ungrabbed paste_from_clipboard
clipboard_control     write-clipboard write-primary no-append

# ── 7. SCROLLBACK & PAGER ─────────────────────────────────
scrollback_lines        20000
scrollback_pager        less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER
wheel_scroll_multiplier 3.0

# ── 8. BELL & NOTIFICATIONS ───────────────────────────────
enable_audio_bell     no
visual_bell_duration  0.3
visual_bell_color     #cba6f7
command_on_bell       none
notify_on_cmd_finish  invisible 15.0

# ── 9. PERFORMANCE & INTEGRATION ─────────────────────────
repaint_delay         8
input_delay           2
sync_to_monitor       yes
update_check_interval 0
shell_integration     enabled
shell                 zsh

# ── 10. COLORS — CATPPUCCIN MOCHA ─────────────────────────
foreground              #cdd6f4
background              #1e1e2e
selection_foreground    #1e1e2e
selection_background    #cba6f7

url_color               #f5e0dc
active_border_color     #b4befe
inactive_border_color   #6c7086
bell_border_color       #f9e2af

active_tab_foreground   #11111b
active_tab_background   #cba6f7
inactive_tab_foreground #cdd6f4
inactive_tab_background #181825
tab_bar_background      #11111b

mark1_foreground #1e1e2e
mark1_background #b4befe
mark2_foreground #1e1e2e
mark2_background #cba6f7
mark3_foreground #1e1e2e
mark3_background #74c7ec

# Black (surface0 / surface2)
color0  #45475a
color8  #585b70
# Red (red / brighter red)
color1  #f38ba8
color9  #f7a8ba
# Green (green / brighter green)
color2  #a6e3a1
color10 #b6f0b2
# Yellow (yellow / brighter warm yellow)
color3  #f9e2af
color11 #fcedc5
# Blue (blue / brighter blue)
color4  #89b4fa
color12 #a6c8ff
# Magenta / Pink (pink / brighter pink)
color5  #f5c2e7
color13 #f8d5ee
# Cyan / Teal (teal / brighter sky)
color6  #94e2d5
color14 #a8f0e4
# White (subtext1 / text)
color7  #bac2de
color15 #cdd6f4

# ── 11. KEYBINDINGS ────────────────────────────────────────

# Pane Navigation & Splits (Vim-style)
map kitty_mod+h neighboring_window left
map kitty_mod+j neighboring_window down
map kitty_mod+k neighboring_window up
map kitty_mod+l neighboring_window right

map kitty_mod+enter launch --location=hsplit --cwd=current
map kitty_mod+minus launch --location=vsplit --cwd=current

# Layout Management
map kitty_mod+z toggle_layout stack
map kitty_mod+shift+z next_layout
map kitty_mod+r start_resizing_window

# Tab Management
map kitty_mod+t new_tab_with_cwd
map kitty_mod+w close_tab
map kitty_mod+shift+h previous_tab
map kitty_mod+shift+l next_tab
map kitty_mod+1 goto_tab 1
map kitty_mod+2 goto_tab 2
map kitty_mod+3 goto_tab 3
map kitty_mod+4 goto_tab 4
map kitty_mod+shift+enter detach_tab

# Font Zoom Controls
map kitty_mod+equal        change_font_size all +1.0
map kitty_mod+shift+minus  change_font_size all -1.0
map kitty_mod+0            change_font_size all 0
map ctrl+equal             change_font_size all +1.0
map ctrl+minus             change_font_size all -1.0
map ctrl+0                 change_font_size all 0

# Scrollback & Kittens
map kitty_mod+f8 show_scrollback

# Hint Pickers (Leader: kitty_mod+p)
map kitty_mod+p>f kitten hints --type path
map kitty_mod+p>l kitten hints --type line
map kitty_mod+p>h kitten hints --type hash
map kitty_mod+p>i kitten hints --type regex --regex "[0-9]{1,3}(\\.[0-9]{1,3}){3}"
map kitty_mod+p>y kitten hints --type word

# Transparency Controls (Leader: kitty_mod+a)
map kitty_mod+a>m set_background_opacity +0.1
map kitty_mod+a>l set_background_opacity -0.1
map kitty_mod+a>1 set_background_opacity 1
map kitty_mod+a>d set_background_opacity default
