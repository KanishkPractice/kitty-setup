# Aesthetic Rice & Lounge Session
# Launch with: kitty --session ~/.config/kitty/sessions/rice.session
#          or: rice  (shell alias)

new_tab aesthetic
layout splits
cd ~
launch --title visualizer zsh -c 'cava 2>/dev/null || pipes-rs 2>/dev/null || cmatrix -C red'
launch --location=vsplit --title monitor zsh -c 'btop 2>/dev/null || htop 2>/dev/null || top'
launch --location=hsplit --title clock zsh -c 'tty-clock -C 1 -c -s -b 2>/dev/null || pipes-rs 2>/dev/null || cbonsai -l 2>/dev/null || zsh'
